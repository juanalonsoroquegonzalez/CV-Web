---
import Section from "./Section.astro";
import Reveal from "./Reveal.astro";
---
<Section title="Disponibilidad y Movilidad">

  <div class="space-y-4 text-gray-700 dark:text-gray-300">

    <Reveal delay={0}>
      <div class="flex items-start gap-3">
        <span class="mt-1 text-lg">✔</span>
        <p>
          Disponibilidad para cambiar de residencia.
        </p>
      </div>
    </Reveal>

    <Reveal delay={120}>
      <div class="flex items-start gap-3">
        <span class="mt-1 text-lg">✔</span>
        <p>
          Disponibilidad para trabajo presencial, híbrido o remoto.
        </p>
      </div>
    </Reveal>

    <Reveal delay={240}>
      <div class="flex items-start gap-3">
        <span class="mt-1 text-lg">✔</span>
        <p>
          Posibilidad de adaptación a horarios y requerimientos del proyecto.
        </p>
      </div>
    </Reveal>
    <Reveal delay={240}>
      <div class="flex items-start gap-3">
        <span class="mt-1 text-lg">✔</span>
        <p>
          Movilidad mediante transporte público.
        </p>
      </div>
    </Reveal>

  </div>

</Section>
