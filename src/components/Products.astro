---
import Section from "./Section.astro";
---
<Section title="Productos Académicos">

  <div class="space-y-8">

    <div class="relative pl-6 border-l border-gray-300 dark:border-gray-700">
      <span
        class="absolute -left-[7px] top-1
               w-3 h-3 rounded-full
               bg-gray-900 dark:bg-gray-100"
      ></span>

      <h3 class="font-semibold text-lg">
        IA para Automóvil Sustentable y Eléctrico
      </h3>

      <p class="text-sm text-gray-500 mb-2">
        Universidad de Guadalajara · Ene 2023 - Nov 2024
      </p>

      <ul class="list-disc ml-5 text-gray-700 dark:text-gray-300">
        <li>Desarrollo de aplicación móvil</li>
        <li>Diseño e implementación de una IA para manejo autónomo</li>
        <li>Enfoque en eficiencia energética y sustentabilidad</li>
      </ul>
    </div>

  </div>

</Section>
