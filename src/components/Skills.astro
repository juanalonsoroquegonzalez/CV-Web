---
import Section from "./Section.astro";
import Reveal from "./Reveal.astro";

const skills = [
  "SQL Server",
  "MySQL",
  "Oracle",
  "PostgreSQL",
  "SQLite",
  "MariaDB",
  "Python",
  "C#",
  "C",
  "C++",
  "Java",
  "JavaScript",
  "TypeScript",
  "jQuery",
  "HTML",
  "CSS",
  "Tailwind CSS",
  "Astro",
  "React",
  "Node.js",
  "Windows Forms",
  ".NET Framework",
  ".NET Core",
  "Visual Studio Code",
  "Visual Studio",
  "Git"
];
---
<Section title="Habilidades Técnicas">

  <div class="flex flex-wrap gap-3 text-gray-700 dark:text-gray-300">
    {skills.map((skill, i) => (
      <Reveal delay={i * 120}>
        <span
          class="px-4 py-2 rounded-full text-sm
                 bg-gray-100 dark:bg-gray-800
                 hover:-translate-y-0.5
                 transition"
        >
          {skill}
        </span>
      </Reveal>
    ))}
  </div>

</Section>
