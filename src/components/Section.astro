---
const { title } = Astro.props;
---
<section class="max-w-4xl mx-auto px-6 py-10 text-gray-800 dark:text-gray-200">
  <div
    class="bg-white/80 dark:bg-gray-900/80
           backdrop-blur
           rounded-2xl
           shadow-sm hover:shadow-md
           transition-shadow
           p-8"
  >
    <h2
      class="text-xl font-semibold mb-6
             border-b border-gray-200 dark:border-gray-700 pb-2"
    >
      {title}
    </h2>

    <div class="space-y-6">
      <slot />
    </div>
  </div>
</section>
