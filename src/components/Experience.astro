---
import Section from "./Section.astro";
---
<Section title="Experiencia Laboral">

  <div class="relative pl-6 border-l border-gray-300 dark:border-gray-700">
    <span
    class="absolute -left-[7px] top-1
           w-3 h-3 rounded-full
           bg-gray-900 dark:bg-gray-100"
  ></span>
    <h3 class="font-semibold text-lg text-gray-900 dark:text-gray-100">
      Analista de Datos – IDITpyme
    </h3>
    <p class="text-sm text-gray-400 mb-2">
      Ago 2023 - Abr 2024
    </p>
    <ul class="list-disc ml-5 text-gray-500">
      <li>Administrador de bases de datos</li>
      <li>Limpieza y procesamiento de datos</li>
    </ul>
  </div>

  <div class="relative pl-6 border-l border-gray-300 dark:border-gray-700">
    <span
    class="absolute -left-[7px] top-1
           w-3 h-3 rounded-full
           bg-gray-900 dark:bg-gray-100"
  ></span>
    <h3 class="font-semibold text-lg text-gray-900 dark:text-gray-100">
      Desarrollador de Software – IT University
    </h3>
    <p class="text-sm text-gray-400 mb-2">
      Sep 2024 - Dic 2025
    </p>
    <ul class="list-disc ml-5 text-gray-500">
      <li>Desarrollo y mantenimiento de software</li>
      <li>Gestión de bases de datos</li>
    </ul>
  </div>
</div>


</Section>
