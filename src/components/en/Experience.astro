---
import Section from "../Section.astro";
---
<Section title="Work Experience">

  <div class="relative pl-6 border-l border-gray-300 dark:border-gray-700">
    <span
      class="absolute -left-[7px] top-1
             w-3 h-3 rounded-full
             bg-gray-900 dark:bg-gray-100"
    ></span>
    <h3 class="font-semibold text-lg text-gray-900 dark:text-gray-100">
      Data Analyst – IDITpyme
    </h3>
    <p class="text-sm text-gray-400 mb-2">
      Aug 2023 - Apr 2024
    </p>
    <ul class="list-disc ml-5 text-gray-500">
      <li>Database administration</li>
      <li>Data cleaning and processing</li>
    </ul>
  </div>

  <div class="relative pl-6 border-l border-gray-300 dark:border-gray-700">
    <span
      class="absolute -left-[7px] top-1
             w-3 h-3 rounded-full
             bg-gray-900 dark:bg-gray-100"
    ></span>
    <h3 class="font-semibold text-lg text-gray-900 dark:text-gray-100">
      Software Developer – IT University
    </h3>
    <p class="text-sm text-gray-400 mb-2">
      Sep 2024 - Dec 2025
    </p>
    <ul class="list-disc ml-5 text-gray-500">
      <li>Software development and maintenance</li>
      <li>Database management</li>
    </ul>
  </div>

</Section>
