---
import Section from "../Section.astro";
import Reveal from "../Reveal.astro";
---
<Section title="Social Networks">

  <div class="flex flex-wrap justify-center gap-6">

    <!-- LinkedIn -->
    <Reveal delay={0}>
      <a
        href="https://www.linkedin.com/in/juan-alonso-roque-gonzalez-7146b22b0"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 px-6 py-4
               rounded-xl bg-white/70 dark:bg-gray-900/70
               backdrop-blur shadow-sm hover:shadow-md
               transition hover:-translate-y-1"
      >
        <svg class="w-6 h-6 text-blue-600" viewBox="0 0 24 24" fill="currentColor">
          <path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1 4.98 2.12 4.98 3.5zM0 24h5V7H0v17zM7.5 7h4.8v2.3h.07c.67-1.27 2.3-2.6 4.73-2.6 5.05 0 5.98 3.32 5.98 7.64V24h-5v-8.2c0-1.96-.04-4.48-2.73-4.48-2.73 0-3.15 2.13-3.15 4.33V24h-5V7z"/>
        </svg>

        <div>
          <p class="font-medium">LinkedIn</p>
          <p class="text-sm text-gray-500">@JuanRoque</p>
        </div>
      </a>
    </Reveal>

    <!-- GitHub -->
    <Reveal delay={120}>
      <a
        href="https://github.com/juanalonsoroquegonzalez"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 px-6 py-4
               rounded-xl bg-white/70 dark:bg-gray-900/70
               backdrop-blur shadow-sm hover:shadow-md
               transition hover:-translate-y-1"
      >
        <svg class="w-6 h-6 text-gray-800 dark:text-gray-200" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 .5C5.73.5.5 5.74.5 12.02c0 5.11 3.29 9.44 7.86 10.97.58.11.79-.25.79-.56
                   0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.35-1.29-1.71-1.29-1.71
                   -1.06-.73.08-.72.08-.72 1.17.08 1.78 1.21 1.78 1.21
                   1.04 1.78 2.73 1.27 3.4.97.1-.75.41-1.27.75-1.56
                   -2.55-.29-5.23-1.28-5.23-5.69
                   0-1.26.45-2.29 1.2-3.1
                   -.12-.29-.52-1.47.11-3.06
                   0 0 .97-.31 3.18 1.18
                   .92-.26 1.9-.39 2.88-.39
                   .98 0 1.96.13 2.88.39
                   2.2-1.49 3.17-1.18 3.17-1.18
                   .64 1.59.24 2.77.12 3.06
                   .75.81 1.2 1.84 1.2 3.1
                   0 4.42-2.69 5.39-5.25 5.67
                   .42.36.8 1.08.8 2.18
                   0 1.58-.01 2.85-.01 3.24
                   0 .31.21.68.8.56
                   4.56-1.53 7.84-5.86 7.84-10.97
                   C23.5 5.74 18.27.5 12 .5z"/>
        </svg>

        <div>
          <p class="font-medium">GitHub</p>
          <p class="text-sm text-gray-500">@juanalonsoroquegonzalez</p>
        </div>
      </a>
    </Reveal>

    <!-- Facebook -->
    <Reveal delay={240}>
      <a
        href="https://www.facebook.com/juan.roquegonzalez/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 px-6 py-4
               rounded-xl bg-white/70 dark:bg-gray-900/70
               backdrop-blur shadow-sm hover:shadow-md
               transition hover:-translate-y-1"
      >
        <svg class="w-6 h-6 text-blue-700" viewBox="0 0 24 24" fill="currentColor">
          <path d="M22.675 0h-21.35C.597 0 0 .597 0 1.326v21.348C0 23.403.597 24 1.326 24h11.495v-9.294H9.691V11.01h3.13V8.309c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.796.715-1.796 1.764v2.314h3.587l-.467 3.696h-3.12V24h6.116C23.403 24 24 23.403 24 22.674V1.326C24 .597 23.403 0 22.675 0z"/>
        </svg>

        <div>
          <p class="font-medium">Facebook</p>
          <p class="text-sm text-gray-500">/juan.roquegonzalez</p>
        </div>
      </a>
    </Reveal>

    <!-- Instagram -->
    <Reveal delay={360}>
      <a
        href="https://www.instagram.com/jrg.alonso/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 px-6 py-4
               rounded-xl bg-white/70 dark:bg-gray-900/70
               backdrop-blur shadow-sm hover:shadow-md
               transition hover:-translate-y-1"
      >
        <svg class="w-6 h-6 text-pink-600" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 1.366.062 2.633.343 3.608 1.318.975.975 1.256 2.242 1.318 3.608.058 1.266.07 1.646.07 4.85s-.012 3.584-.07 4.85c-.062 1.366-.343 2.633-1.318 3.608-.975.975-2.242 1.256-3.608 1.318-1.266.058-1.646.07-4.85.07s-3.584-.012-4.85-.07c-1.366-.062-2.633-.343-3.608-1.318-.975-.975-1.256-2.242-1.318-3.608C2.175 15.747 2.163 15.367 2.163 12s.012-3.584.07-4.85c.062-1.366.343-2.633 1.318-3.608.975-.975 2.242-1.256 3.608-1.318C8.416 2.175 8.796 2.163 12 2.163zm0 3.675a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zm0 10.162a3.999 3.999 0 110-7.998 3.999 3.999 0 010 7.998zm6.406-11.845a1.44 1.44 0 11-2.88 0 1.44 1.44 0 012.88 0z"/>
        </svg>

        <div>
          <p class="font-medium">Instagram</p>
          <p class="text-sm text-gray-500">@jrg.alonso</p>
        </div>
      </a>
    </Reveal>

  </div>

</Section>
