---
import Section from "../Section.astro";
import Reveal from "../Reveal.astro";
---
<Section title="Availability and Mobility">

  <div class="space-y-4 text-gray-700 dark:text-gray-300">

    <Reveal delay={0}>
      <div class="flex items-start gap-3">
        <span class="mt-1 text-lg">✔</span>
        <p>
          Willingness to relocate.
        </p>
      </div>
    </Reveal>

    <Reveal delay={120}>
      <div class="flex items-start gap-3">
        <span class="mt-1 text-lg">✔</span>
        <p>
          Availability for on-site, hybrid, or remote work.
        </p>
      </div>
    </Reveal>

    <Reveal delay={240}>
      <div class="flex items-start gap-3">
        <span class="mt-1 text-lg">✔</span>
        <p>
          Ability to adapt to project schedules and requirements.
        </p>
      </div>
    </Reveal>
    <Reveal delay={240}>
      <div class="flex items-start gap-3">
        <span class="mt-1 text-lg">✔</span>
        <p>
          Mobility via public transportation.
        </p>
      </div>
    </Reveal>

  </div>

</Section>
