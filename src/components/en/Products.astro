---
import Section from "../Section.astro";
---
<Section title="Academic Projects">

  <div class="space-y-8">

    <div class="relative pl-6 border-l border-gray-300 dark:border-gray-700">
      <span
        class="absolute -left-[7px] top-1
               w-3 h-3 rounded-full
               bg-gray-900 dark:bg-gray-100"
      ></span>

      <h3 class="font-semibold text-lg">
        AI for Sustainable and Electric Vehicles
      </h3>

      <p class="text-sm text-gray-500 mb-2">
        University of Guadalajara · Jan 2023 - Nov 2024
      </p>

      <ul class="list-disc ml-5 text-gray-700 dark:text-gray-300">
        <li>Development of a mobile application</li>
        <li>Design and implementation of AI for autonomous driving</li>
        <li>Focus on energy efficiency and sustainability</li>
      </ul>
    </div>

  </div>

</Section>
