---
import Section from "../Section.astro";
---
<Section title="Teaching Experience">

  <div class="space-y-8">

    <div class="relative pl-6 border-l border-gray-300 dark:border-gray-700">
      <span
        class="absolute -left-[7px] top-1
               w-3 h-3 rounded-full
               bg-gray-900 dark:bg-gray-100"
      ></span>

      <h3 class="font-semibold text-lg">
        Database Instructor
      </h3>

      <p class="text-sm text-gray-500 mb-2">
        IT University · Nov 2024 - Sep 2025
      </p>

      <ul class="list-disc ml-5 text-gray-700 dark:text-gray-300">
        <li>SQL Server Database Administration Course</li>
        <li>Oracle Database Administration-Oriented Course</li>
        <li>Data Analysis Application Course with MySQL, Python, and Power BI</li>
      </ul>
    </div>

  </div>

</Section>
