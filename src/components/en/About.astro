---
import Reveal from "../Reveal.astro";
---
<section class="max-w-3xl mx-auto p-6 text-gray-800 dark:text-gray-200">

  <Reveal>
    <h2 class="text-2xl font-bold mb-6 text-gray-900 dark:text-gray-100">
      About Me
    </h2>
  </Reveal>

  <div class="space-y-4 leading-relaxed">

    <Reveal delay={120}>
      <p>
        Graduate in <strong>Computer Engineering</strong>, with a focus on
        <strong>quality, security, and continuous improvement</strong> in the
        development of technological solutions.
      </p>
    </Reveal>

    <Reveal delay={240}>
      <p>
        I have experience in <strong>data analysis</strong>,
        <strong>database administration</strong>, and
        <strong>software development</strong>, actively participating in
        academic and professional projects.
      </p>
    </Reveal>

    <Reveal delay={360}>
      <p>
        I am characterized by a <strong>positive and solution-oriented attitude</strong>,
        strong <strong>teamwork skills</strong>, and the ability to
        <strong>adapt to new challenges</strong>, always aiming to add value
        and achieve results.
      </p>
    </Reveal>

    <Reveal delay={480}>
      <p>
        I seek to join environments where I can
        <strong>continuously learn</strong>, apply my knowledge, and contribute
        to the development of efficient and well-structured solutions.
      </p>
    </Reveal>

  </div>

</section>
